# Firebase web app config (Project settings > Your apps). These identify the app; they are not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). Use ONE of these for deployed builds:
VITE_RECAPTCHA_V3_SITE_KEY=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only: an App Check debug token registered in the Firebase console
# (App Check > Apps > Manage debug tokens), or "true" to print a new one in the console.
# Never commit a real debug token or ship it in a public build.
VITE_APPCHECK_DEBUG_TOKEN=
