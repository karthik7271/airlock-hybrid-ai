rules_version = '2';

// Airlock stores only redacted cases in Firestore. The vault that maps placeholders back to
// real values never leaves the user's device. These rules add a server-side backstop: a write
// is rejected if the redacted text still looks like it contains an email, SSN or card number.
service cloud.firestore {
  match /databases/{database}/documents {
    function looksRedacted(text) {
      return text is string
        && text.size() < 60000
        && !text.matches('(?s).*[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}.*')
        && !text.matches('(?s).*\\b[0-9]{3}-[0-9]{2}-[0-9]{4}\\b.*')
        && !text.matches('(?s).*\\b(?:[0-9][ -]?){15}[0-9]\\b.*');
    }

    function validCase() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'title', 'docType', 'urgency', 'redactedText', 'analysis', 'lang', 'protectedCount', 'createdAt'])
        && d.id is string && d.title is string && d.title.size() < 200
        && d.lang is string && d.lang.size() < 10
        && d.protectedCount is int
        && looksRedacted(d.redactedText);
    }

    match /users/{uid}/cases/{caseId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && validCase();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
